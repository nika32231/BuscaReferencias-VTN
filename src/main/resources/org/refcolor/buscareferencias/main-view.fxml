<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.refcolor.buscareferencias.controller.DrawingController"
            stylesheets="@style.css">

    <top>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" styleClass="toolbar-scroll">
            <content>
                <ToolBar fx:id="toolBar">
                    <!-- Marca visual de la app -->
                    <Label text="◆" styleClass="brand-mark"/>
                    <Separator orientation="VERTICAL"/>
                    <Button fx:id="btnClear" text="🗑 Limpiar" onAction="#handleClear">
                        <tooltip><Tooltip text="Borrar todo el lienzo"/></tooltip>
                    </Button>
                    <Button fx:id="btnUndo" text="↩ Deshacer" onAction="#handleUndo"/>
                    <Button fx:id="btnRedo" text="↪ Rehacer" onAction="#handleRedo"/>
                    <Separator orientation="VERTICAL"/>
                    <ToggleButton fx:id="btnDraw" text="✎ Dibujar" selected="true" styleClass="tool-button"/>
                    <ToggleButton fx:id="btnErase" text="🧽 Borrar" styleClass="tool-button"/>
                    <Separator orientation="VERTICAL"/>
                    <Button fx:id="btnSearch" text="🔍 Buscar fotos" onAction="#handleLocalPhotoSearch" styleClass="search-button-large"/>
                    <Separator orientation="VERTICAL"/>
                    <Button fx:id="btnAddPhotos" text="➕ Añadir fotos" onAction="#handleAddPhotos" styleClass="add-photos-button">
                        <tooltip><Tooltip text="Añadir imágenes a la biblioteca de referencias"/></tooltip>
                    </Button>
                    <Separator orientation="VERTICAL"/>
                    <Button fx:id="btnHelp" text="❓" onAction="#handleHelp" styleClass="help-button">
                        <tooltip><Tooltip text="Ver el tutorial de nuevo"/></tooltip>
                    </Button>
                    <Button fx:id="btnLang" text="🌐 EN" onAction="#handleLang" styleClass="help-button">
                        <tooltip><Tooltip text="Switch language / Cambiar idioma"/></tooltip>
                    </Button>
                </ToolBar>
            </content>
        </ScrollPane>
    </top>

    <center>
        <BorderPane>
            <left>
                <VBox fx:id="sidePalette" spacing="5" prefWidth="210" minWidth="190" styleClass="side-palette">
                    <padding>
                        <Insets top="10" right="8" bottom="8" left="8"/>
                    </padding>
                    <Label fx:id="lblPalette" text="PALETA DE CUERPO" styleClass="section-title" />
                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="flat-scroll">
                        <VBox fx:id="paletteContainer" spacing="6" styleClass="palette-container">
                            <!-- Los botones de la paleta se generan dinámicamente -->
                        </VBox>
                    </ScrollPane>
                </VBox>
            </left>

            <center>
                <!-- SplitPane VERTICAL: canvas arriba / galería abajo -->
                <SplitPane fx:id="canvasGallerySplitPane" orientation="VERTICAL" dividerPositions="0.60">
                    <StackPane fx:id="canvasRoot" styleClass="canvas-root" minHeight="320">
                        <StackPane fx:id="canvasContainer" styleClass="canvas-container" minWidth="280" minHeight="220" prefWidth="900" prefHeight="600" maxWidth="1600" maxHeight="1200">
                            <Canvas fx:id="canvas"
                                    width="900" height="600"
                                    onMousePressed="#handleMousePressed"
                                    onMouseDragged="#handleMouseDragged"
                                    onMouseReleased="#handleMouseReleased"
                                    onMouseMoved="#handleMouseMoved"
                                    onMouseExited="#handleMouseExited"/>
                        </StackPane>
                    </StackPane>

                    <VBox spacing="0" styleClass="gallery-root">
                        <Label fx:id="lblGallery" text="GALERÍA DE REFERENCIAS" styleClass="gallery-section-title">
                            <VBox.margin><Insets bottom="4"/></VBox.margin>
                        </Label>
                        <!-- StackPane: galería real + placeholder cuando está vacía -->
                        <StackPane VBox.vgrow="ALWAYS">
                            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="flat-scroll">
                                <FlowPane fx:id="galleryPane" hgap="10" vgap="10" prefWrapLength="900" styleClass="gallery-pane">
                                    <!-- Las imágenes aparecen aquí -->
                                </FlowPane>
                            </ScrollPane>
                            <!-- Estado vacío: visible mientras no haya resultados -->
                            <VBox fx:id="galleryEmptyState" alignment="CENTER" spacing="14"
                                  mouseTransparent="true" styleClass="gallery-empty-state">
                                <padding><Insets bottom="36"/></padding>
                                <Label text="✦" styleClass="gallery-empty-icon"/>
                                <Label fx:id="galleryEmptyLabel"
                                       text="Dibuja una pose y pulsa 🔍 para buscar referencias"
                                       wrapText="true" textAlignment="CENTER"
                                       maxWidth="440"
                                       styleClass="gallery-empty-text"/>
                            </VBox>
                        </StackPane>
                    </VBox>
                </SplitPane>
            </center>
        </BorderPane>
    </center>

    <bottom>
        <VBox styleClass="status-bar">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="status-row">
                <Label fx:id="lblStatusPrefix" text="Estado:" styleClass="status-prefix"/>
                <Label fx:id="statusLabel" text="Listo para dibujar" HBox.hgrow="ALWAYS"/>
                <Label fx:id="batchNumLabel" text="" styleClass="batch-info-label"/>
            </HBox>
            <VBox fx:id="progressWrapper" visible="false" managed="false" spacing="5" styleClass="search-progress-panel">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="lblBatch" text="Lote" styleClass="progress-row-label" minWidth="46"/>
                    <StackPane HBox.hgrow="ALWAYS">
                        <ProgressBar fx:id="batchProgressBar" prefHeight="10" maxWidth="Infinity" progress="0" styleClass="batch-progress-bar"/>
                        <Label fx:id="batchPctLabel" text="" styleClass="progress-pct-small" mouseTransparent="true"/>
                    </StackPane>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="lblTotal" text="Total" styleClass="progress-row-label" minWidth="46"/>
                    <StackPane HBox.hgrow="ALWAYS">
                        <ProgressBar fx:id="progressBar" prefHeight="20" maxWidth="Infinity" progress="0"/>
                        <Label fx:id="progressLabel" text="" styleClass="progress-label" mouseTransparent="true"/>
                    </StackPane>
                </HBox>
            </VBox>
        </VBox>
    </bottom>

</BorderPane>
